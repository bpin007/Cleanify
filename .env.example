# Copy to .env (gitignored) and fill in. Never commit real values.
# The owner creates every account and key; see README "Accounts checklist".

# ── API ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME=Cleanify
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ANON_SESSION_SECRET=

# ── Google OAuth ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudflare R2 ─────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_UPLOADS=cleanify-uploads
R2_BUCKET_OUTPUTS=cleanify-outputs

# ── Retention (correction 5) ──────────────────────────────────────────
# The cleanup Worker uses the same values as Worker variables (wrangler.toml).
ANON_RETENTION_MINUTES=60
API_RETENTION_HOURS=24

# ── Translation ───────────────────────────────────────────────────────
CF_ACCOUNT_ID=
CF_AI_API_TOKEN=
MYMEMORY_EMAIL=
# e.g. https://<user>-<space>.hf.space, or http://localhost:5000 for local Docker
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# Order of the fallback chain
TRANSLATION_PROVIDERS=cloudflare,mymemory,libretranslate
# Shorter pieces use column/paragraph/document-level detection (correction 8)
LANG_DETECT_MIN_CHARS=20

# ── Email ─────────────────────────────────────────────────────────────
# Brevo (decision D17). Used in production only: development prints emails to the console.
EMAIL_API_KEY=
# A sender verified in Brevo.
EMAIL_FROM=
# Sender name shown to recipients (default: APP_NAME).
EMAIL_FROM_NAME=

# ── Web (Vite) ────────────────────────────────────────────────────────
VITE_APP_NAME=Cleanify
# The browser always calls same-origin /api/* (correction 6).
# Dev only: where the Vite dev server forwards /api/*.
API_PROXY_TARGET=http://localhost:4000

# ── Pages Function proxy (production; set in the Cloudflare Pages dashboard, not here)
# API_ORIGIN=https://<service>.onrender.com
