    "cookie-parser": "1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "jose": "6.2.17",
    "mongoose": "9.12.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
