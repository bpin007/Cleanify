{
  "name": "@cleanify/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Cleanify conversion engine. Pure TypeScript: no DOM and no Node APIs, so it runs in the browser Web Worker and the server job runner alike.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "any-ascii": "0.3.3",
    "buffer": "6.0.3",
    "exceljs": "4.4.0",
    "iconv-lite": "0.7.3",
    "mdb-reader": "3.2.0",
    "papaparse": "^5.7.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "fast-check": "^4.10.3"
  }
}
